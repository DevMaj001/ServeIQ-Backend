# Database
DATABASE_URL=postgresql://user:password@host:5432/database

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Field-level encryption at rest (AES-256-GCM) for PINs / sensitive fields.
# REQUIRED in production — the app refuses to boot without it.
# For the first production deploy, set this to the SAME value as JWT_SECRET so
# any existing encrypted data stays decryptable. Do NOT rotate casually afterwards
# (existing ciphertext would become undecryptable until re-encrypted).
ENCRYPTION_KEY=

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:4200

# Paystack Configuration
PAYSTACK_SECRET_KEY=sk_test_REPLACE_ME
PAYSTACK_PUBLIC_KEY=pk_test_REPLACE_ME

# Nemotron/LLM Configuration
NEMOTRON_API_KEY=your-nemotron-api-key
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=meta/llama-3.1-70b-instruct

# Beta program
BETA_MODE=true
# Error monitoring (Sentry). Set a real DSN in production/staging.
SENTRY_DSN=

# Moniepoint POS API (reconciliation + webhook delivery monitoring)
# Base URL for the sandbox/prod POS API. Sandbox is typically provided by the
# Moniepoint integration onboarding pack; production is https://api.pos.moniepoint.com
MONIEPOINT_API_BASE_URL=https://api.pos.moniepoint.com
MONIEPOINT_API_KEY=your-moniepoint-api-key
# Webhook subscription registered for this deployment:
#   curl $MONIEPOINT_API_BASE_URL/v1/webhook-subscriptions \
#     -H "Authorization: Bearer $MONIEPOINT_API_KEY"
MONIEPOINT_WEBHOOK_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
# Authoritative environment gate. GET /v1/introspect declares the environment an
# API key is scoped to (SANDBOX|PROD); the preflight command HARD-FAILS when this
# disagrees. Always set explicitly to PROD before any real-money test.
MONIEPOINT_EXPECTED_ENVIRONMENT=SANDBOX

# Moniepoint Channel/ERP Client Credentials (separate auth model from the POS
# API-key above). These are OAuth client credentials exchanged for a bearer
# token via POST /v1/auth — NOT sent directly as a Bearer key. Generated from
# the business console under POS Terminal Configuration > ERP Integration.
# CONFIRMED (2026-09-17, sandbox auth succeeded against it): the Channel/ERP
# API is served from a SINGLE base URL for both sandbox and production; the
# environment is declared by which credential you use (Sandbox is chosen when
# creating the credential). The "moniepoint-pos-backend-service.development
# .moniepoint.com" hostname seen in the docs is a stale hyperlink, not a second
# host. This env var remains optional here: per-branch tenants provide their own
# credentials at runtime (MoniepointErpService), so leave it empty unless a
# platform-owned default client is needed.
MONIEPOINT_CHANNEL_BASE_URL=
MONIEPOINT_CLIENT_ID=your-moniepoint-client-id
MONIEPOINT_CLIENT_API_KEY=your-moniepoint-client-api-key
# Comma-separated scopes preflight requires (default: webhook:read). Add
# webhook:write if auto-resend is ever enabled.
MONIEPOINT_REQUIRED_SCOPES=webhook:read
# Reconciliation window / pending-staleness tolerances (minutes)
MONIEPOINT_RECONCILE_WINDOW_MINUTES=360
MONIEPOINT_PENDING_STALE_MINUTES=120

# ── Added by the production-readiness audit (previously undocumented) ──
# Force SSL to the database outside NODE_ENV=production
DB_SSL=false
# Expose Swagger in production (default off)
SWAGGER_ENABLED=false
# Receipt PDFs and image uploads — REQUIRED in production
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Public origin for guest menu / QR links — REQUIRED in production
PUBLIC_MENU_BASE_URL=http://localhost:3000
# One-time bootstrap token for POST /auth/setup-super-admin.
# Leave unset to keep the route disabled (404).
SUPERADMIN_SETUP_TOKEN=
# Moniepoint webhook replay window (seconds, default 300)
MONIEPOINT_MAX_WEBHOOK_AGE_SECONDS=300
# ERP push staleness / lookup delay (minutes, defaults 60 / 2)
MONIEPOINT_PUSH_STALE_MINUTES=60
MONIEPOINT_PUSH_LOOKUP_DELAY_MINUTES=2
